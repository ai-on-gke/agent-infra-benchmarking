# Prints the secrets .github/workflows/upload-source.yml reads to upload to a
# deployment's state bucket: SOURCE_BUCKET, from its backend.hcl, and
# GCP_CREDENTIALS, a new key of the service account its github_actions_bucket
# created. With --set, stores them as secrets of this repo with gh instead,
# printing neither.
#
# The account keeps one key: any it had are deleted before the new one is
# made, so a run is also how the key is rotated.
#
#   get-gh-actions-gcs-config [--set] DEPLOYMENT

set -o errexit -o nounset -o pipefail

usage() {
  echo "Usage: $0 [--set] DEPLOYMENT" >&2
  exit 2
}

SET=false
if [[ "${1:-}" == --set ]]; then
  SET=true
  shift
fi
[[ $# -eq 1 ]] || usage

DEPLOYMENT_DIR="$(cd "$(dirname "$0")/../deployments" && pwd)/$1"
if [[ ! -f "${DEPLOYMENT_DIR}/backend.hcl" ]]; then
  echo "Error: no ${DEPLOYMENT_DIR}/backend.hcl" >&2
  exit 1
fi

BUCKET="$(sed -n 's/^bucket *= *"\(.*\)"/\1/p' "${DEPLOYMENT_DIR}/backend.hcl")"
SERVICE_ACCOUNT="$(terraform -chdir="${DEPLOYMENT_DIR}" output -json cloud_run | jq -r '.github_service_account_email // empty')"
if [[ -z "${BUCKET}" || -z "${SERVICE_ACCOUNT}" ]]; then
  echo "Error: no bucket in backend.hcl, or no github_actions_bucket applied in $1" >&2
  exit 1
fi

mapfile -t OLD_KEYS < <(gcloud iam service-accounts keys list --iam-account="${SERVICE_ACCOUNT}" \
  --managed-by=user --format='value(name.basename())')
for key in "${OLD_KEYS[@]}"; do
  gcloud iam service-accounts keys delete "${key}" --iam-account="${SERVICE_ACCOUNT}" --quiet
done

KEY_FILE="$(mktemp)"
trap 'rm -f "${KEY_FILE}"' EXIT
gcloud iam service-accounts keys create "${KEY_FILE}" --iam-account="${SERVICE_ACCOUNT}" --quiet
# One line, as a secret's value is pasted.
CREDENTIALS="$(jq -c . "${KEY_FILE}")"

if [[ "${SET}" == true ]]; then
  # gh takes the repo from the git remote of where it runs, and a value on
  # stdin, keeping the key out of the process list.
  (
    cd "${DEPLOYMENT_DIR}"
    gh secret set SOURCE_BUCKET <<<"${BUCKET}"
    gh secret set GCP_CREDENTIALS <<<"${CREDENTIALS}"
  )
else
  echo "SOURCE_BUCKET=${BUCKET}"
  echo "GCP_CREDENTIALS=${CREDENTIALS}"
fi
