# Runs tests.yaml's dummy case in a deployment's Cloud Run job with
# trigger, passing every other orchestrator option on unchanged. Its cluster
# is benchmarking/tests/infra/clusters/dummy, which creates nothing in
# GCP; benchmarking/automation/infra still does.
#
#   trigger-dummy --deployment=DEPLOYMENT [ORCHESTRATOR_ARG...]

set -o errexit -o nounset -o pipefail

exec "$(dirname "$0")/trigger" --test-case-name=dummy "$@"
