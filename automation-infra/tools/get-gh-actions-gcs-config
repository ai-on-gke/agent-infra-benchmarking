# Prints the repository variables .github/workflows/upload-source.yml reads to
# upload to a deployment's state bucket through Workload Identity Federation:
# GCP_WORKLOAD_IDENTITY_PROVIDER_<DEPLOYMENT> and GCP_SERVICE_ACCOUNT_<DEPLOYMENT>,
# from the deployment's outputs. With --set, sets them on this repo with gh
# instead, then deletes what keyless auth replaces: the account's user-managed
# keys and the secret GCP_CREDENTIALS_<DEPLOYMENT>.

set -o errexit -o nounset -o pipefail

source "$(dirname "$0")/lib.sh"

usage() {
  echo "Usage: $0 --deployment=DEPLOYMENT [--set]" >&2
  exit 2
}

parse_deployment "$@"
SET=false
for arg in "${ARGS[@]}"; do
  [[ "${arg}" == --set ]] || usage
  SET=true
done

SUFFIX="$(tr 'a-z-' 'A-Z_' <<<"${DEPLOYMENT}")"
OUTPUTS="$(terraform -chdir="${DEPLOYMENT_DIR}" output -json cloud_run)"
SERVICE_ACCOUNT="$(jq -r '.github_service_account_email // empty' <<<"${OUTPUTS}")"
PROVIDER="$(jq -r '.github_workload_identity_provider // empty' <<<"${OUTPUTS}")"
if [[ -z "${SERVICE_ACCOUNT}" || -z "${PROVIDER}" ]]; then
  echo "Error: no github_actions_bucket applied in ${DEPLOYMENT}, or applied before Workload Identity Federation" >&2
  exit 1
fi

if [[ "${SET}" != true ]]; then
  echo "GCP_WORKLOAD_IDENTITY_PROVIDER_${SUFFIX}=${PROVIDER}"
  echo "GCP_SERVICE_ACCOUNT_${SUFFIX}=${SERVICE_ACCOUNT}"
  exit 0
fi

cd "${DEPLOYMENT_DIR}"
gh variable set "GCP_WORKLOAD_IDENTITY_PROVIDER_${SUFFIX}" --body "${PROVIDER}"
gh variable set "GCP_SERVICE_ACCOUNT_${SUFFIX}" --body "${SERVICE_ACCOUNT}"
mapfile -t KEYS < <(gcloud iam service-accounts keys list --iam-account="${SERVICE_ACCOUNT}" \
  --managed-by=user --format='value(name.basename())')
for key in "${KEYS[@]}"; do
  gcloud iam service-accounts keys delete "${key}" --iam-account="${SERVICE_ACCOUNT}" --quiet
done
gh secret delete "GCP_CREDENTIALS_${SUFFIX}" 2>/dev/null || true
echo "Set; the workflow authenticates without a key from its next run."
