# run_tests.py's Python: PyYAML to read tests.yaml. requirements.txt is
# compiled from this with every dependency pinned and hashed, for the image's
# Python 3.11 on linux/amd64:
#
#   uv pip compile requirements.in --python-version 3.11 \
#     --python-platform x86_64-manylinux_2_28 --generate-hashes -o requirements.txt

pyyaml==6.0.3
