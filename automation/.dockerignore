# Also what infra/cloud-run's gcloud builds submit leaves out of the upload,
# so the patterns are ones both docker and gcloud read alike.

# A local terraform init's providers and state, which would otherwise end up
# in the runner image.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/__pycache__/
# The infra that builds the image, not part of it.
/infra/
