# A local terraform init's providers and state, which would otherwise end up
# in the orchestrator image.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!scenarios/infra/clusters/common/default.tfvars
**/__pycache__/
scenario_runner/.terraform-plugin-cache/
scenario_runner/local-runs/
scenario_runner/.dev-infra/
# The venv tools/run makes.
tools/venv_run/
