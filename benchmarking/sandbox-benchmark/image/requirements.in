# The comparator image's Python: ai-sandbox-benchmark's own requirements, as
# comparator.py imports every provider's SDK; ate-env-client's dependencies,
# the client itself being installed from the env submodule; and
# google-cloud-storage for run_comparator.py's upload. requirements.txt is
# compiled from this with every transitive dependency pinned and hashed, for
# the image's Python 3.12 on linux/amd64, again whenever the submodule's
# requirements change:
#
#   uv pip compile requirements.in --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 --generate-hashes -o requirements.txt

-r ../../../dependency-repos/ai-sandbox-benchmark/requirements.txt
# ate-env-client's, from dependency-repos/env/clients/python/pyproject.toml.
grpcio>=1.83
protobuf>=7.35
google-cloud-storage==3.17.0
