# Runs the runner locally, passing every option on unchanged, in a venv beside
# this script that has runner/requirements.txt installed:
#
#   ./benchmarking/automation/tools/run --project-id my-project \
#     --state-bucket my-bucket --state-prefix tests --test-case-name glutton

set -o errexit -o nounset -o pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUTOMATION_DIR="$(dirname "${TOOLS_DIR}")"
VENV="${TOOLS_DIR}/venv_run"
REQUIREMENTS="${AUTOMATION_DIR}/runner/requirements.txt"

# Made afresh once requirements.txt changes, against the copy kept in the venv,
# which is written last so an install cut short is redone.
if ! cmp -s "${REQUIREMENTS}" "${VENV}/requirements.txt"; then
  rm -rf "${VENV}"
  python3 -m venv "${VENV}"
  "${VENV}/bin/pip" install --quiet --require-hashes -r "${REQUIREMENTS}"
  cp "${REQUIREMENTS}" "${VENV}/requirements.txt"
fi

# PYTHONPATH rather than a cd, so relative paths in the options stay relative
# to where it is run.
PYTHONPATH="${AUTOMATION_DIR}" exec "${VENV}/bin/python" -m runner "$@"
