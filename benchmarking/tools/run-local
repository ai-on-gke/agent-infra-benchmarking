# Runs the scenario-runner with tools/run, its infra's state in local files
# under benchmarking/scenario_runner/.local-data/runs/terraform/<name>/, passing
# every other option on unchanged:
#
#   ./benchmarking/tools/run-local --project-id my-project \
#     --scenario glutton-gvisor

set -o errexit -o nounset -o pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec "${TOOLS_DIR}/run" --state-backend local "$@"
