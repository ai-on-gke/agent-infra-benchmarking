# Lists or destroys what the scenario-runner's executions with
# --state-backend=gcs left in the state bucket, with
# python3 -m scenario_runner.cli.runs in tools/python:
#
#   runs --state-bucket=BUCKET --state-prefix=PREFIX list [--json]
#   runs --state-bucket=BUCKET --state-prefix=PREFIX destroy RUN_ID...

set -o errexit -o nounset -o pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec "${TOOLS_DIR}/python" -m scenario_runner.cli.runs "$@"
