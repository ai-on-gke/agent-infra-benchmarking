# Runs python with every argument, in a venv beside this script that has
# scenario_runner/requirements.txt installed, the scenario_runner package
# importable, and benchmarking/.env.sh sourced if there is one:
#
#   ./benchmarking/tools/python -m scenario_runner.cli.dev_infra --help

set -o errexit -o nounset -o pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNER_DIR="$(dirname "${TOOLS_DIR}")/scenario_runner"
VENV="${TOOLS_DIR}/venv_run"
REQUIREMENTS="${RUNNER_DIR}/requirements.txt"
ENV_FILE="$(dirname "${TOOLS_DIR}")/.env.sh"

if [[ -f "${ENV_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${ENV_FILE}"
fi

# Made afresh once requirements.txt changes, against the copy kept in the venv,
# which is written last so an install cut short is redone.
if ! cmp -s "${REQUIREMENTS}" "${VENV}/requirements.txt"; then
  rm -rf "${VENV}"
  python3 -m venv "${VENV}"
  "${VENV}/bin/pip" install --quiet --disable-pip-version-check --require-hashes -r "${REQUIREMENTS}"
  cp "${REQUIREMENTS}" "${VENV}/requirements.txt"
fi

# PYTHONPATH rather than a cd, so relative paths in the options stay relative
# to where it is run.
PYTHONPATH="${RUNNER_DIR}/src" exec "${VENV}/bin/python" "$@"
