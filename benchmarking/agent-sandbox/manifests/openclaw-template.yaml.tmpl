apiVersion: extensions.agents.x-k8s.io/v1beta1
kind: SandboxTemplate
metadata:
  name: ${NAME}
  namespace: ${NAMESPACE}
spec:
  networkPolicyManagement: Unmanaged
  podTemplate:
    spec:
      runtimeClassName: ${RUNTIME_CLASS}
      dnsPolicy: ClusterFirst
      nodeSelector:
        benchmarking-worker: "true"
      tolerations:
      - key: ate.dev/sandboxClass
        operator: Exists
        effect: NoSchedule
      containers:
      - name: openclaw
        image: ${IMAGE}
        command: ["python3", "-u", "/app/openclaw_actor.py"]
        env:
        - name: OPENCLAW_USE_MOCK_LLM
          value: "true"
        - name: MOCK_LLM_BASE_URL
          value: "http://mock-llm.${NAMESPACE}.svc.cluster.local/v1"
        - name: OPENCLAW_TIMEOUT_SECS
          value: "${OPENCLAW_TIMEOUT_SECS}"
        ports:
        - containerPort: 80
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: 80
          initialDelaySeconds: 2
          periodSeconds: 5
        resources:
          limits:
            memory: 2Gi
