apiVersion: extensions.agents.x-k8s.io/v1beta1
kind: SandboxTemplate
metadata:
  name: ${NAME}
  namespace: ${NAMESPACE}
spec:
  networkPolicyManagement: Unmanaged
  podTemplate:
    spec:
      runtimeClassName: ${RUNTIME_CLASS}
      dnsPolicy: ClusterFirst
      nodeSelector:
        benchmarking-worker: "true"
      tolerations:
      - key: ate.dev/sandboxClass
        operator: Exists
        effect: NoSchedule
      containers:
      - name: glutton
        image: ${IMAGE}
        command:
        - "/ko-app/glutton"
        - "--grpc-listen-addr=:80"
        - "--metrics-listen-addr=:9090"
        - "--data-dir=/tmp/glutton"
        - "--mode=http"
        ports:
        - containerPort: 80
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: 80
          initialDelaySeconds: 1
          periodSeconds: 2
        resources:
          limits:
            memory: 256Mi
