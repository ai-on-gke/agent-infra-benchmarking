apiVersion: extensions.agents.x-k8s.io/v1beta1
kind: SandboxTemplate
metadata:
  name: ${NAME}
  namespace: ${NAMESPACE}
spec:
  networkPolicyManagement: Unmanaged
  podTemplate:
    spec:
      runtimeClassName: ${RUNTIME_CLASS}
      dnsPolicy: ClusterFirst
      nodeSelector:
        benchmarking-worker: "true"
      tolerations:
      - key: ate.dev/sandboxClass
        operator: Exists
        effect: NoSchedule
      containers:
      - name: rl-rollout
        image: ${IMAGE}
        command: ["python3", "-u", "/app/rl_actor.py"]
        env:
        - name: PORT
          value: "80"
        - name: RL_EXEC_TIMEOUT_SECS
          value: "30"
        ports:
        - containerPort: 80
          name: http
        readinessProbe:
          httpGet:
            path: /readyz
            port: 80
          initialDelaySeconds: 2
          periodSeconds: 5
        resources:
          limits:
            memory: 512Mi
