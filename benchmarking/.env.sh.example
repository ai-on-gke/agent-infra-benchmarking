# Copy to .env.sh, which tools/python sources, and fill in.

# GCP project the scenario-runner creates the infra in, unless --project-id is given.
export PROJECT_ID="<YOUR_PROJECT_ID>"

# Where the scenario-runner keeps the infra's Terraform state, unless
# --state-backend, --state-bucket and --state-prefix are given. Either local
# files:
export STATE_BACKEND="local"

# or a GCS bucket, each execution's state under <prefix>/<name>:
# export STATE_BACKEND="gcs"
# export STATE_BUCKET="<YOUR_PROJECT_ID>-tfstate"
# export STATE_PREFIX="terraform"
