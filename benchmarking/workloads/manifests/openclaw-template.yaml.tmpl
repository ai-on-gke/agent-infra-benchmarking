metadata:
  atespace: benchmark-workloads
  name: openclaw
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: openclaw
  image: ${IMAGE_WITH_DIGEST}
  command: ["python3", "-u", "/app/openclaw_actor.py"]
  env:
  # Configure Vertex AI
  - name: GOOGLE_CLOUD_PROJECT
    value: "${PROJECT_ID}"
  - name: VERTEX_REGION
    value: "${GCE_REGION}"
  - name: GOOGLE_CLOUD_LOCATION
    value: "${GCE_REGION}"
  - name: GCP_SA_KEY_B64
    value: "${GCP_SA_KEY_B64}"
  readyz:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: memory
    quantity: ${ACTOR_MEMORY}
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/openclaw/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
