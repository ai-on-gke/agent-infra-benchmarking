metadata:
  atespace: benchmark-workloads
  name: openclaw
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: openclaw
  image: us-docker.pkg.dev/${PROJECT_ID}/gcr.io/ate-images/openclaw-workload@sha256:ee4a8e35f90a15dae4b7a168a48179f80d13bd99bf0e2fd4582e8579ab884f5e
  command: ["python3", "-u", "/app/openclaw_actor.py"]
  env:
  # OpenClaw likely requires an LLM API key to function. 
  # You can safely substitute this using envsubst before applying, or hardcode a test key here.
  - name: OPENAI_API_KEY
    value: "${OPENAI_API_KEY}"
  readyz:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: memory
    quantity: ${ACTOR_MEMORY}
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/openclaw/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
