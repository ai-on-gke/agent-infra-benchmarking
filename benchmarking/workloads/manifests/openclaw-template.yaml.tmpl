metadata:
  atespace: benchmark-workloads
  name: openclaw
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: openclaw
  image: ${IMAGE_WITH_DIGEST}
  command: ["python3", "-u", "/app/openclaw_actor.py"]
  env:
  - name: OPENCLAW_USE_MOCK_LLM
    value: "true"
  - name: MOCK_LLM_BASE_URL
    value: "http://mock-llm.benchmark-workloads.svc.cluster.local/v1"
  # The case's workload-timeout less 20s (workloads/openclaw.py).
  - name: OPENCLAW_TIMEOUT_SECS
    value: "${OPENCLAW_TIMEOUT_SECS}"
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
    cpuMillicores: "${ACTOR_CPU_MILLICORES}"
    memoryBytes: "${ACTOR_MEMORY_BYTES}"
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
