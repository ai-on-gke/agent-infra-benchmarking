# SandboxTemplate for the ping benchmark workload (benchmarking/workloads/probe),
# created by workloads/deploy.sh. This is the agent-sandbox analog of
# substrate's glutton ActorTemplate: a minimal, purpose-built target whose
# only job is to prove a sandbox is up and answering, so activation latency
# isn't buried under application startup time.
#
# service: true gives every Sandbox this template produces its own per-pod
# Service and status.serviceFQDN, which is how runworkload addresses it —
# agent-sandbox needs no atenet-style shared router for this benchmark.
#
# The controller's default Managed NetworkPolicy allows ingress only from
# the sandbox-router (see examples/openclaw-gvisor-sandbox and the
# NetworkPolicySpec docs in extensions/api/v1beta1/sandboxtemplate_types.go),
# which is exactly the router this template's direct-addressing design
# doesn't use — the boomer-worker pod's requests would be silently dropped
# without the override below. It replaces the default policy rather than
# extending it (see NetworkPolicyManagement's own doc comment), so egress is
# deliberately left empty (deny-all): the probe makes no outbound calls of
# its own.
apiVersion: extensions.agents.x-k8s.io/v1beta1
kind: SandboxTemplate
metadata:
  name: ping
  namespace: ${BENCHMARK_NAMESPACE}
spec:
  networkPolicy:
    ingress:
    - from:
      - namespaceSelector:
          matchLabels:
            kubernetes.io/metadata.name: ${BENCHMARK_NAMESPACE}
      ports:
      - protocol: TCP
        port: 8888
  podTemplate:
    metadata:
      labels:
        sandbox: ping-template-sandbox
    spec:
      ${RUNTIME_CLASS_LINE}
      automountServiceAccountToken: false
      containers:
      - name: probe
        image: ${PROBE_IMAGE}
        ports:
        - containerPort: 8888
        readinessProbe:
          httpGet:
            path: /healthz
            port: 8888
          periodSeconds: 1
          failureThreshold: 1
        # Unset means no limit, which is fine for this probe: it holds no
        # meaningful memory of its own, unlike substrate's ACTOR_MEMORY knob
        # (sized against the microvm 128Mi floor for a real actor payload).
        resources:
          limits:
            memory: ${PING_MEMORY}
  service: true
