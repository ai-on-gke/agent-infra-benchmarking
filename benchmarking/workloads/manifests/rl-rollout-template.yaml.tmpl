metadata:
  atespace: benchmark-workloads
  name: rl-rollout
workerSelector:
  matchLabels:
    workload: benchmark-ateom
containers:
- name: rl-rollout
  image: ${IMAGE_WITH_DIGEST}
  command: ["python3", "-u", "/app/rl_actor.py"]
  env:
  - name: PORT
    value: "80"
  - name: RL_EXEC_TIMEOUT_SECS
    value: "30"
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
resources:
  limits:
  - name: memory
    quantity: ${ACTOR_MEMORY}
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
  storageLocation: gs://${BUCKET_NAME}/benchmark-workloads/rl-rollout/
sandboxConfig:
  sandboxClass: ${SANDBOX_CLASS_ENUM}
  configName: ${SANDBOX_CONFIG_NAME}
