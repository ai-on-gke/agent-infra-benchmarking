project_id = "<YOUR_PROJECT_ID>"
region     = "us-central1"

# The deafult name for all resources. The cluster takes it too, unless
# cluster.name below overrides it.
default_resource_name = "<PICK_YOUR_NAME>"

# Lets terraform destroy delete the bucket, and with it every run's reports
# under reports/. Download any worth keeping first, or set this to false.
bucket_force_destroy = true

cluster = {
  # Pins the control plane alongside the node pools below, so it doesn't
  # drift to whatever the release channel resolves to.
  kubernetes_version = "1.35.8-gke.1225000"

  # Without these, substrate's podcertificate-controller never creates the
  # ClusterTrustBundles and hack/install-ate.sh waits for them forever.
  k8s_beta_apis = [
    "certificates.k8s.io/v1beta1/clustertrustbundles",
    "certificates.k8s.io/v1beta1/podcertificaterequests",
  ]

  node_pools = {
    default = {
      machine_type   = "c2-standard-16"
      node_count     = 1
      node_locations = ["us-central1-a"]
      # Pinned rather than auto-upgraded; bump it deliberately when needed.
      version      = "1.35.8-gke.1225000"
      auto_upgrade = false
      min_node_count = 1
      max_node_count = 1
    }
    sandboxed = {
      machine_type   = "c2-standard-16"
      node_count     = 30
      node_locations = ["us-central1-a"]
      min_node_count = 30
      max_node_count = 30
      # ate.dev/substrate-version is not set here: Terraform reads it off the
      # substrate submodule and adds it to every pool. See main.tf.
      labels = {
        "benchmarking-worker" = "true",
      }
      # workloads.yaml.tmpl's WorkerPool already tolerates this taint; without
      # it actually applied to the nodes, nothing stops substrate's own
      # control-plane pods (and anything else) from also landing here
      # alongside the workers, which is how a 100-worker run blows past GKE's
      # 110-pods-per-node cap on this single pinned node.
      taints = [
        {
          key    = "ate.dev/sandboxClass"
          value  = "gvisor"
          effect = "NO_SCHEDULE"
        }
      ]
      # Pinned rather than auto-upgraded; bump it deliberately when needed.
      version      = "1.35.8-gke.1225000"
      auto_upgrade = false
    }
    # A micro-VM (kata + cloud-hypervisor) worker pool. Nested virtualization
    # exposes /dev/kvm, which the microvm sandbox class boots its guest on; c2
    # supports it, E2 does not. The taint matches the WorkerPool's
    # ate.dev/sandboxClass toleration, so only microvm workers land here. Drop
    # this pool if you only run the gvisor class.
    microvm = {
      machine_type                 = "c2-standard-16"
      node_count                   = 1
      node_locations               = ["us-central1-a"]
      min_node_count               = 1
      max_node_count               = 1
      enable_nested_virtualization = true
      labels = {
        "benchmarking-worker" = "true",
      }
      taints = [
        {
          key    = "ate.dev/sandboxClass"
          value  = "microvm"
          effect = "NO_SCHEDULE"
        }
      ]
      # Pinned rather than auto-upgraded; bump it deliberately when needed.
      version      = "1.35.8-gke.1225000"
      auto_upgrade = false
    }
  }
}
