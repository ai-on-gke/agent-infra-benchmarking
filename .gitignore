**/__pycache__/

# Reports downloaded from the bucket.
/reports/*
!/reports/run-20261015t144424z/
!/reports/run-20261015t192645z/

# What `pip install ./benchmark-charts` leaves behind.
/.venv/
/benchmark-charts/build/

# Local settings benchmarking/tools source, from .env.sh.example.
/benchmarking/.env.sh

# The venv benchmarking/tools/run makes.
/benchmarking/tools/venv_run/

# Each scenario-runner execution's Terraform deployments in runs/, and the dev
# infras', which the scenario-runner's --dev-infra keeps, in dev-infra/.
/benchmarking/scenario_runner/.local-data/
*.egg-info/

# The providers the scenario-runner's cluster applies share.
/benchmarking/scenario_runner/.terraform-plugin-cache/
