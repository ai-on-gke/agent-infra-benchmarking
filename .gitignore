# Per-developer environment settings, copied from env.sh.example.
.env.sh

**/__pycache__/

# Reports downloaded from the bucket.
/reports/*
!/reports/20261001t184243z/

# What `pip install ./benchmark-charts` leaves behind.
/.venv/
/benchmark-charts/build/

# The venv benchmarking/automation/tools/run makes.
/benchmarking/automation/tools/venv_run/

# Each orchestrator execution's local state and Terraform data.
/benchmarking/automation/local-runs/
*.egg-info/

# The providers the orchestrator's cluster applies share.
/benchmarking/automation/.terraform-plugin-cache/
