**/__pycache__/

# Reports downloaded from the bucket.
/reports/*
!/reports/20261001t184243z/

# What `pip install ./benchmark-charts` leaves behind.
/.venv/
/benchmark-charts/build/

# The venv benchmarking/tools/run makes.
/benchmarking/tools/venv_run/

# Each orchestrator execution's local state and Terraform data.
/benchmarking/scenario_runner/local-runs/
# The dev infras' Terraform files, which the orchestrator's --dev-infra keeps.
/benchmarking/scenario_runner/.dev-infra/
*.egg-info/

# The providers the orchestrator's cluster applies share.
/benchmarking/scenario_runner/.terraform-plugin-cache/
