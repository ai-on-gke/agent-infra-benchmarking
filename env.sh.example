# Example environment variables for Substrate development.
# Copy this file to .env.sh and customize it for your environment.
#
# The settings that describe the deployment itself - the project, the region,
# the cluster, the bucket and the image repository - are not written here: they
# come from .terraform-env.sh, which reads them off the Terraform state, so
# this file and the infrastructure cannot drift into naming different
# resources. Everything below is what Terraform does not know.

# Path from this file's own location, so the values are the ones next to it
# whatever directory the sourcing script runs from. zsh arrays are 1-indexed
# by default, so BASH_SOURCE[0] is empty there (the bash-compatible path is
# at [1]); fall back to zsh's own %x prompt-expansion instead. That syntax
# isn't valid bash, so it's kept inside a string and reached only through
# eval, rather than written where bash's parser would see it directly.
if [ -n "${ZSH_VERSION:-}" ]; then
  _ENV_SELF="$(eval 'print -r -- "${(%):-%x}"')"
else
  _ENV_SELF="${BASH_SOURCE[0]}"
fi
_ENV_DIR="$(cd "$(dirname "${_ENV_SELF}")" && pwd)"
unset _ENV_SELF
# shellcheck source=.terraform-env.sh
source "${_ENV_DIR}/.terraform-env.sh" || return 1 2>/dev/null || exit 1
unset _ENV_DIR

# ---------------------------------------------------------------------------
export KUBECTL_CONTEXT=

# Set this if you want to override the default build platforms
export KO_DEFAULTPLATFORMS=linux/amd64
