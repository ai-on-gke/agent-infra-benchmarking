# Example environment variables for agent-infra-benchmarking. Copy this file
# to .env.sh and customize it for your environment. Which of the variables
# below are actually read depends on --backend: substrate reads through
# BUCKET_NAME/KO_*/OPENCLAW_IMAGE, agent-sandbox only needs PROJECT_ID plus
# the optional overrides at the bottom. See README.md for the full flag
# surface of each.

export PROJECT_ID=${USER}-gke-dev
export PROJECT_NUMBER=$(gcloud projects describe ${PROJECT_ID} --format="value(projectNumber)")

export GCE_REGION=us-west1
export CLUSTER_LOCATION=us-west1-c

export NETWORK=default
export SUBNETWORK=default

export CLUSTER_NAME=substrate-poc
# Supported: 1.36 (needs the beta APIs enabled at cluster creation, which
# setup-gcp does) or 1.37+ (APIs served by default). Anything below 1.36 does
# not work. GKE retires patch versions over time — if cluster creation rejects
# this pin, pick a current one from:
#   gcloud container get-server-config --zone ${CLUSTER_LOCATION} --format="value(defaultClusterVersion)"
# See tools/setup-gcp/README.md ("Create Cluster") for the full constraint.
export CLUSTER_VERSION=1.36.3-gke.1767000
export NODE_POOL_NAME=gvisor-pool
export NODE_POOL_VERSION=1.36.3-gke.1767000
export GVISOR_NODE_MACHINE_TYPE=c3-standard-4
# Boot disk customizations (optional; defaults to GKE's default boot disk)
# export BOOT_DISK_SIZE_GB=500
# export BOOT_DISK_TYPE=hyperdisk-balanced

# Set this if you are using an existing cluster with a different context name.
export KUBECTL_CONTEXT=

export BUCKET_NAME=snapshot-substrate-test-${PROJECT_ID}

export KO_DOCKER_REPO="gcr.io/${PROJECT_ID}/ate-images"

# The actor image the openclaw workload drives. Defined here rather than in
# benchmarking/locust/build_and_push.sh so that the one script pushing it and
# anything resolving it name the same string: a build and a deployment that
# disagree leave the ActorTemplate pulling an image nothing builds.
export OPENCLAW_IMAGE="us-docker.pkg.dev/${PROJECT_ID}/gcr.io/ate-images/openclaw-workload:latest"

# Set this if you want to override the default build platforms
export KO_DEFAULTPLATFORMS=linux/amd64

# --- --backend agent-sandbox only, below this line ---

# Optional: an OTLP gRPC collector endpoint reachable from the cluster
# (host:port, no scheme). Unset is fine — the boomer worker still reports
# every window through Prometheus and the locust stats CSV without one; this
# only adds the ColdCreate/PoolClaim span breakdown.
# export OTEL_COLLECTOR_ENDPOINT=opentelemetry-collector.otel-system.svc.cluster.local:4317

# Override only if a custom registry path is needed; otherwise both are
# derived from PROJECT_ID the same way in every script that needs them.
# export LOCUST_IMAGE=us-docker.pkg.dev/${PROJECT_ID}/agent-infra-benchmarking/locust-runworkload:latest
# export PROBE_IMAGE=us-docker.pkg.dev/${PROJECT_ID}/agent-infra-benchmarking/ping-probe:latest
